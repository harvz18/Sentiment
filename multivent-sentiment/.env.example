APP_ENV=development
AI_PROVIDER=rag_fallback
OPENAI_API_KEY=
OPENAI_MODEL=
ANALYSIS_API_KEY=
BINARY_SENTIMENT=true
DOMAIN_RELEVANCE_THRESHOLD=0.40
DOMAIN_TEST_FRACTION=0.10
DOMAIN_VALIDATION_FRACTION=0.10
RAG_BALANCE_CLASSES=true
RAG_LANGUAGE_K=2
RAG_DOMAIN_K=4
RAG_TOP_K=6
RAG_HILISENTI_WEIGHT=1.0
RAG_DOMAIN_WEIGHT=1.2
RAG_INCLUDE_VALIDATION=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=main
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false
LDA_NUM_TOPICS=10
LDA_MAX_FEATURES=10000
LDA_MIN_DF=2
LDA_MAX_DF=0.95
LDA_RANDOM_STATE=42
LDA_MAX_ITER=20
LDA_NGRAM_MAX=1
ENABLE_PII_SANITIZATION=false
ENABLE_ANALYSIS_LOGGING=true
HF_HUB_DISABLE_SYMLINKS_WARNING=1
